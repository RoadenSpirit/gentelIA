[Unit]
Description=OpenCode Live Quota Widget Injector Proxy
After=network.target opencode-server.service

[Service]
Type=simple
WorkingDirectory=/home/your-user/scripts/opencode-quota-widget
Environment=PATH=/home/your-user/.nvm/versions/node/v22.23.4/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/your-user/.nvm/versions/node/v22.23.4/bin/node /home/your-user/scripts/opencode-quota-widget/injector.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
